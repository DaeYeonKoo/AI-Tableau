      <aliases enabled='yes' />
    <column caption='Claim Id' datatype='string' name='[claim_id]' role='dimension' type='nominal' />
    <column caption='Customer' datatype='string' name='[customer]' role='dimension' type='nominal' />
    <column caption='Customer Plant' datatype='string' name='[customer_plant]' role='dimension' type='nominal' />
    <column caption='Claim Country' datatype='string' name='[claim_country]' role='dimension' type='nominal' />
    <column caption='Claim Language' datatype='string' name='[claim_language]' role='dimension' type='nominal' />
    <column caption='Claim Description' datatype='string' name='[claim_description]' role='dimension' type='nominal' />
    <column caption='Production Plant' datatype='string' name='[production_plant]' role='dimension' type='nominal' />
    <column caption='Production Country' datatype='string' name='[production_country]' role='dimension' type='nominal' />
    <column caption='Part Category' datatype='string' name='[part_category]' role='dimension' type='nominal' />
    <column caption='Part Name Ko' datatype='string' name='[part_name_ko]' role='dimension' type='nominal' />
    <column caption='Part Name En' datatype='string' name='[part_name_en]' role='dimension' type='nominal' />
    <column caption='Part Number' datatype='string' name='[part_number]' role='dimension' type='nominal' />
    <column caption='Production Date' datatype='date' name='[production_date]' role='dimension' type='ordinal' />
    <column caption='Delivery Date' datatype='date' name='[delivery_date]' role='dimension' type='ordinal' />
    <column caption='Occurrence Date' datatype='date' name='[occurrence_date]' role='dimension' type='ordinal' />
    <column caption='Claim Received Date' datatype='date' name='[claim_received_date]' role='dimension' type='ordinal' />
    <column caption='Claim Confirmed Date' datatype='date' name='[claim_confirmed_date]' role='dimension' type='ordinal' />
    <column caption='Claim Status' datatype='string' name='[claim_status]' role='dimension' type='nominal' />
    <column caption='Defect Type Ko' datatype='string' name='[defect_type_ko]' role='dimension' type='nominal' />
    <column caption='Defect Type En' datatype='string' name='[defect_type_en]' role='dimension' type='nominal' />
    <column caption='Severity' datatype='string' name='[severity]' role='dimension' type='nominal' />
    <column caption='Claim Quantity' datatype='integer' name='[claim_quantity]' role='measure' type='quantitative' />
    <column caption='Unit Price Usd' datatype='real' name='[unit_price_usd]' role='measure' type='quantitative' />
    <column caption='Claim Amount Usd' datatype='real' name='[claim_amount_usd]' role='measure' type='quantitative' />
    <column caption='Lead Time To Receive' datatype='integer' name='[Calculation_LeadTimeToReceive]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [occurrence_date], [claim_received_date])' />
    </column>
    <column caption='Lead Time To Confirm' datatype='integer' name='[Calculation_LeadTimeToConfirm]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [claim_received_date], [claim_confirmed_date])' />
    </column>
    <column caption='Total Cycle Time' datatype='integer' name='[Calculation_TotalCycleTime]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [occurrence_date], [claim_confirmed_date])' />
    </column>
    <column caption='Is Open' datatype='boolean' name='[Calculation_IsOpen]' role='dimension' type='nominal'>
      <calculation class='tableau' formula='[claim_status] = &quot;접수&quot; OR [claim_status] = &quot;조사중&quot;' />
    </column>
    <column caption='Is Confirmed Liable' datatype='boolean' name='[Calculation_IsConfirmedLiable]' role='dimension' type='nominal'>
      <calculation class='tableau' formula='[claim_status] = &quot;확정&quot; OR [claim_status] = &quot;보상완료&quot;' />
    </column>
    <column caption='Occurrence Month' datatype='date' name='[Calculation_OccurrenceMonth]' role='dimension' type='ordinal'>
      <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [occurrence_date])' />
    </column>
    <column caption='Date Range Filter' datatype='boolean' name='[Calculation_DateRangeFilter]' role='dimension' type='nominal'>
      <calculation class='tableau' formula='[occurrence_date] &gt;= [Parameters].[Parameter 1] AND [occurrence_date] &lt;= [Parameters].[Parameter 2]' />
    </column>
    <column caption='KPI Last1M Amount' datatype='real' name='[Calculation_KPILast1MAmount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2025-12-01# AND [occurrence_date] &lt;= #2025-12-31# THEN [claim_amount_usd] END' />
    </column>
    <column caption='KPI Last1M Count' datatype='integer' name='[Calculation_KPILast1MCount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2025-12-01# AND [occurrence_date] &lt;= #2025-12-31# THEN 1 END' />
    </column>
    <column caption='KPI Last1M Prev Amount' datatype='real' name='[Calculation_KPILast1MPrevAmount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2024-12-01# AND [occurrence_date] &lt;= #2024-12-31# THEN [claim_amount_usd] END' />
    </column>
    <column caption='KPI Last1M Prev Count' datatype='integer' name='[Calculation_KPILast1MPrevCount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2024-12-01# AND [occurrence_date] &lt;= #2024-12-31# THEN 1 END' />
    </column>
    <column caption='KPI Last1M Card' datatype='string' name='[Calculation_KPILast1MCard]' role='measure' type='nominal'>
      <calculation class='tableau' formula='&quot;최근 1개월&quot; + CHAR(10) + &quot;2025.12 · 전년동기比&quot; + CHAR(10) + CHAR(10) + STR(SUM([Calculation_KPILast1MCount])) + &quot;건&quot; + CHAR(10) + IIF(SUM([Calculation_KPILast1MCount]) &gt;= SUM([Calculation_KPILast1MPrevCount]), &quot;▲&quot;, &quot;▼&quot;) + &quot; &quot; + STR(ROUND(ABS(SUM([Calculation_KPILast1MCount]) - SUM([Calculation_KPILast1MPrevCount])) / SUM([Calculation_KPILast1MPrevCount]) * 100, 1)) + &quot;%&quot; + CHAR(10) + CHAR(10) + IIF(SUM([Calculation_KPILast1MAmount]) &gt;= 1000000, &quot;$&quot; + STR(ROUND(SUM([Calculation_KPILast1MAmount])/1000000,2)) + &quot;M&quot;, &quot;$&quot; + STR(ROUND(SUM([Calculation_KPILast1MAmount])/1000,1)) + &quot;K&quot;) + CHAR(10) + IIF(SUM([Calculation_KPILast1MAmount]) &gt;= SUM([Calculation_KPILast1MPrevAmount]), &quot;▲&quot;, &quot;▼&quot;) + &quot; &quot; + STR(ROUND(ABS(SUM([Calculation_KPILast1MAmount]) - SUM([Calculation_KPILast1MPrevAmount])) / SUM([Calculation_KPILast1MPrevAmount]) * 100, 1)) + &quot;%&quot;' />
    </column>
    <column caption='KPI Last3M Amount' datatype='real' name='[Calculation_KPILast3MAmount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2025-10-01# AND [occurrence_date] &lt;= #2025-12-31# THEN [claim_amount_usd] END' />
    </column>
    <column caption='KPI Last3M Count' datatype='integer' name='[Calculation_KPILast3MCount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2025-10-01# AND [occurrence_date] &lt;= #2025-12-31# THEN 1 END' />
    </column>
    <column caption='KPI Last3M Prev Amount' datatype='real' name='[Calculation_KPILast3MPrevAmount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2024-10-01# AND [occurrence_date] &lt;= #2024-12-31# THEN [claim_amount_usd] END' />
    </column>
    <column caption='KPI Last3M Prev Count' datatype='integer' name='[Calculation_KPILast3MPrevCount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2024-10-01# AND [occurrence_date] &lt;= #2024-12-31# THEN 1 END' />
    </column>
    <column caption='KPI Last3M Card' datatype='string' name='[Calculation_KPILast3MCard]' role='measure' type='nominal'>
      <calculation class='tableau' formula='&quot;최근 3개월&quot; + CHAR(10) + &quot;2025.10~12 · 전년동기比&quot; + CHAR(10) + CHAR(10) + STR(SUM([Calculation_KPILast3MCount])) + &quot;건&quot; + CHAR(10) + IIF(SUM([Calculation_KPILast3MCount]) &gt;= SUM([Calculation_KPILast3MPrevCount]), &quot;▲&quot;, &quot;▼&quot;) + &quot; &quot; + STR(ROUND(ABS(SUM([Calculation_KPILast3MCount]) - SUM([Calculation_KPILast3MPrevCount])) / SUM([Calculation_KPILast3MPrevCount]) * 100, 1)) + &quot;%&quot; + CHAR(10) + CHAR(10) + IIF(SUM([Calculation_KPILast3MAmount]) &gt;= 1000000, &quot;$&quot; + STR(ROUND(SUM([Calculation_KPILast3MAmount])/1000000,2)) + &quot;M&quot;, &quot;$&quot; + STR(ROUND(SUM([Calculation_KPILast3MAmount])/1000,1)) + &quot;K&quot;) + CHAR(10) + IIF(SUM([Calculation_KPILast3MAmount]) &gt;= SUM([Calculation_KPILast3MPrevAmount]), &quot;▲&quot;, &quot;▼&quot;) + &quot; &quot; + STR(ROUND(ABS(SUM([Calculation_KPILast3MAmount]) - SUM([Calculation_KPILast3MPrevAmount])) / SUM([Calculation_KPILast3MPrevAmount]) * 100, 1)) + &quot;%&quot;' />
    </column>
    <column caption='KPI Last6M Amount' datatype='real' name='[Calculation_KPILast6MAmount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2025-07-01# AND [occurrence_date] &lt;= #2025-12-31# THEN [claim_amount_usd] END' />
    </column>
    <column caption='KPI Last6M Count' datatype='integer' name='[Calculation_KPILast6MCount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2025-07-01# AND [occurrence_date] &lt;= #2025-12-31# THEN 1 END' />
    </column>
    <column caption='KPI Last6M Prev Amount' datatype='real' name='[Calculation_KPILast6MPrevAmount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2024-07-01# AND [occurrence_date] &lt;= #2024-12-31# THEN [claim_amount_usd] END' />
    </column>
    <column caption='KPI Last6M Prev Count' datatype='integer' name='[Calculation_KPILast6MPrevCount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2024-07-01# AND [occurrence_date] &lt;= #2024-12-31# THEN 1 END' />
    </column>
    <column caption='KPI Last6M Card' datatype='string' name='[Calculation_KPILast6MCard]' role='measure' type='nominal'>
      <calculation class='tableau' formula='&quot;최근 6개월&quot; + CHAR(10) + &quot;2025.07~12 · 전년동기比&quot; + CHAR(10) + CHAR(10) + STR(SUM([Calculation_KPILast6MCount])) + &quot;건&quot; + CHAR(10) + IIF(SUM([Calculation_KPILast6MCount]) &gt;= SUM([Calculation_KPILast6MPrevCount]), &quot;▲&quot;, &quot;▼&quot;) + &quot; &quot; + STR(ROUND(ABS(SUM([Calculation_KPILast6MCount]) - SUM([Calculation_KPILast6MPrevCount])) / SUM([Calculation_KPILast6MPrevCount]) * 100, 1)) + &quot;%&quot; + CHAR(10) + CHAR(10) + IIF(SUM([Calculation_KPILast6MAmount]) &gt;= 1000000, &quot;$&quot; + STR(ROUND(SUM([Calculation_KPILast6MAmount])/1000000,2)) + &quot;M&quot;, &quot;$&quot; + STR(ROUND(SUM([Calculation_KPILast6MAmount])/1000,1)) + &quot;K&quot;) + CHAR(10) + IIF(SUM([Calculation_KPILast6MAmount]) &gt;= SUM([Calculation_KPILast6MPrevAmount]), &quot;▲&quot;, &quot;▼&quot;) + &quot; &quot; + STR(ROUND(ABS(SUM([Calculation_KPILast6MAmount]) - SUM([Calculation_KPILast6MPrevAmount])) / SUM([Calculation_KPILast6MPrevAmount]) * 100, 1)) + &quot;%&quot;' />
    </column>
    <column caption='KPI Last12M Amount' datatype='real' name='[Calculation_KPILast12MAmount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2025-01-01# AND [occurrence_date] &lt;= #2025-12-31# THEN [claim_amount_usd] END' />
    </column>
    <column caption='KPI Last12M Count' datatype='integer' name='[Calculation_KPILast12MCount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2025-01-01# AND [occurrence_date] &lt;= #2025-12-31# THEN 1 END' />
    </column>
    <column caption='KPI Last12M Prev Amount' datatype='real' name='[Calculation_KPILast12MPrevAmount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2024-01-01# AND [occurrence_date] &lt;= #2024-12-31# THEN [claim_amount_usd] END' />
    </column>
    <column caption='KPI Last12M Prev Count' datatype='integer' name='[Calculation_KPILast12MPrevCount]' role='measure' type='quantitative'>
      <calculation class='tableau' formula='IF [occurrence_date] &gt;= #2024-01-01# AND [occurrence_date] &lt;= #2024-12-31# THEN 1 END' />
    </column>
    <column caption='KPI Last12M Card' datatype='string' name='[Calculation_KPILast12MCard]' role='measure' type='nominal'>
      <calculation class='tableau' formula='&quot;최근 12개월&quot; + CHAR(10) + &quot;2025.01~12 · 전년동기比&quot; + CHAR(10) + CHAR(10) + STR(SUM([Calculation_KPILast12MCount])) + &quot;건&quot; + CHAR(10) + IIF(SUM([Calculation_KPILast12MCount]) &gt;= SUM([Calculation_KPILast12MPrevCount]), &quot;▲&quot;, &quot;▼&quot;) + &quot; &quot; + STR(ROUND(ABS(SUM([Calculation_KPILast12MCount]) - SUM([Calculation_KPILast12MPrevCount])) / SUM([Calculation_KPILast12MPrevCount]) * 100, 1)) + &quot;%&quot; + CHAR(10) + CHAR(10) + IIF(SUM([Calculation_KPILast12MAmount]) &gt;= 1000000, &quot;$&quot; + STR(ROUND(SUM([Calculation_KPILast12MAmount])/1000000,2)) + &quot;M&quot;, &quot;$&quot; + STR(ROUND(SUM([Calculation_KPILast12MAmount])/1000,1)) + &quot;K&quot;) + CHAR(10) + IIF(SUM([Calculation_KPILast12MAmount]) &gt;= SUM([Calculation_KPILast12MPrevAmount]), &quot;▲&quot;, &quot;▼&quot;) + &quot; &quot; + STR(ROUND(ABS(SUM([Calculation_KPILast12MAmount]) - SUM([Calculation_KPILast12MPrevAmount])) / SUM([Calculation_KPILast12MPrevAmount]) * 100, 1)) + &quot;%&quot;' />
    </column>
    <column caption='KPI All Card' datatype='string' name='[Calculation_KPIAllCard]' role='measure' type='nominal'>
      <calculation class='tableau' formula='&quot;전체(3개년)&quot; + CHAR(10) + &quot;2023.01~2025.12&quot; + CHAR(10) + CHAR(10) + STR(COUNT([claim_id])) + &quot;건&quot; + CHAR(10) + CHAR(10) + IIF(SUM([claim_amount_usd]) &gt;= 1000000, &quot;$&quot; + STR(ROUND(SUM([claim_amount_usd])/1000000,2)) + &quot;M&quot;, &quot;$&quot; + STR(ROUND(SUM([claim_amount_usd])/1000,1)) + &quot;K&quot;)' />
    </column>
